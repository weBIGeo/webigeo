{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "webgpu_base",
      "hidden": true,
      "cacheVariables": {
        "ALP_BUILD_GL_ENGINE": "OFF",
        "ALP_BUILD_PLAIN_RENDERER": "OFF",
        "ALP_BUILD_ALPINEAPP": "OFF",
        "ALP_ENABLE_LABELS": "OFF",
        "ALP_ENABLE_AVALANCHE_WARNING_LAYER": "OFF",
        "ALP_BUILD_UNITTESTS": "OFF",
        "ALP_BUILD_WEBGPU_ENGINE": "ON",
        "ALP_BUILD_WEBGPU_APP": "ON",
        "ALP_ENABLE_THREADING": "ON",
        "ALP_ENABLE_DEV_TOOLS": "ON"
      }
    },
    {
      "name": "webgpu_msvc_base",
      "hidden": true,
      "inherits": "webgpu_base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "webgpu_app_msvc_debug",
      "displayName": "weBIGeo (webgpu_app) MSVC Debug",
      "description": "Debug build using MSVC compiler",
      "inherits": "webgpu_msvc_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "/DQT_DEBUG"
      }
    },
    {
      "name": "webgpu_app_msvc_release",
      "displayName": "weBIGeo (webgpu_app) MSVC Release",
      "description": "Release build using MSVC compiler",
      "inherits": "webgpu_msvc_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "unittests_msvc_debug",
      "displayName": "Unittests MSVC Debug",
      "description": "Debug build for unit tests using MSVC compiler",
      "inherits": "webgpu_app_msvc_debug",
      "cacheVariables": {
        "ALP_BUILD_UNITTESTS": "ON",
        "ALP_BUILD_WEBGPU_APP": "OFF"
      }
    },
    {
      "name": "unittests_msvc_release",
      "displayName": "Unittests MSVC Release",
      "description": "Release build for unit tests using MSVC compiler",
      "inherits": "webgpu_app_msvc_release",
      "cacheVariables": {
        "ALP_BUILD_UNITTESTS": "ON",
        "ALP_BUILD_WEBGPU_APP": "OFF"
      }
    },
    {
      "name": "webgpu_macos_base",
      "hidden": true,
      "inherits": "webgpu_base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{HOME}/Qt/6.11.1/macos/lib/cmake"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "webgpu_app_macos_debug",
      "displayName": "weBIGeo (webgpu_app) macOS Debug",
      "description": "Debug build using native macOS Clang compiler",
      "inherits": "webgpu_macos_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-DQT_DEBUG"
      }
    },
    {
      "name": "webgpu_app_macos_release",
      "displayName": "weBIGeo (webgpu_app) macOS Release",
      "description": "Release build using native macOS Clang compiler",
      "inherits": "webgpu_macos_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "webgpu_wasm_base",
      "hidden": true,
      "inherits": "webgpu_base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "toolchainFile": "$env{HOME}/Qt/6.11.1/wasm_multithread/lib/cmake/Qt6/qt.toolchain.cmake",
      "cacheVariables": {
        "QT_HOST_PATH": "$env{HOME}/Qt/6.11.1/macos"
      }
    },
    {
      "name": "webgpu_app_wasm_debug",
      "displayName": "weBIGeo (webgpu_app) WASM Debug",
      "description": "Debug build for WebAssembly using Emscripten",
      "inherits": "webgpu_wasm_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-DQT_DEBUG"
      }
    },
    {
      "name": "webgpu_app_wasm_release",
      "displayName": "weBIGeo (webgpu_app) WASM Release",
      "description": "Release build for WebAssembly using Emscripten",
      "inherits": "webgpu_wasm_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "webgpu_app_wasm_publish",
      "displayName": "weBIGeo (webgpu_app) WASM Publish",
      "description": "Production build for WebAssembly using Emscripten",
      "inherits": "webgpu_wasm_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-DQT_NO_DEBUG_OUTPUT",
        "ALP_ENABLE_WGSL_MINIFICATION": "ON"
      }
    },
    {
      "name": "webgpu_ios_base",
      "hidden": true,
      "inherits": "webgpu_base",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{HOME}/Qt/6.11.1/ios/lib/cmake/Qt6/qt.toolchain.cmake",
      "cacheVariables": {
        "QT_HOST_PATH": "$env{HOME}/Qt/6.11.1/macos",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "17.0",
        "ALP_ENABLE_DEV_TOOLS": "OFF",
        "CMAKE_XCODE_ATTRIBUTE_GCC_WARN_64_TO_32_BIT_CONVERSION": "NO"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "webgpu_app_ios_simulator",
      "displayName": "weBIGeo (webgpu_app) iOS Simulator",
      "description": "iOS Simulator build (arm64), Xcode generator",
      "inherits": "webgpu_ios_base",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "ALP_IOS_PLATFORM": "ios-simulator"
      }
    },
    {
      "name": "webgpu_app_ios",
      "displayName": "weBIGeo (webgpu_app) iOS Device",
      "description": "iPhone build (arm64), Xcode generator; set ALP_IOS_DEVELOPMENT_TEAM for signing",
      "inherits": "webgpu_ios_base",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "ALP_IOS_PLATFORM": "ios"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "webgpu_app_msvc_debug",
      "configurePreset": "webgpu_app_msvc_debug"
    },
    {
      "name": "webgpu_app_msvc_release",
      "configurePreset": "webgpu_app_msvc_release"
    },
    {
      "name": "unittests_msvc_debug",
      "configurePreset": "unittests_msvc_debug"
    },
    {
      "name": "unittests_msvc_release",
      "configurePreset": "unittests_msvc_release"
    },
    {
      "name": "webgpu_app_macos_debug",
      "configurePreset": "webgpu_app_macos_debug"
    },
    {
      "name": "webgpu_app_macos_release",
      "configurePreset": "webgpu_app_macos_release"
    },
    {
      "name": "webgpu_app_wasm_debug",
      "configurePreset": "webgpu_app_wasm_debug"
    },
    {
      "name": "webgpu_app_wasm_release",
      "configurePreset": "webgpu_app_wasm_release"
    },
    {
      "name": "webgpu_app_wasm_publish",
      "configurePreset": "webgpu_app_wasm_publish"
    },
    {
      "name": "webgpu_app_ios_simulator",
      "configurePreset": "webgpu_app_ios_simulator",
      "configuration": "Release",
      "targets": [
        "webgpu_app"
      ]
    },
    {
      "name": "webgpu_app_ios",
      "configurePreset": "webgpu_app_ios",
      "configuration": "Release",
      "targets": [
        "webgpu_app"
      ]
    }
  ]
}
